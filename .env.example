TYPESAFE_API_KEY=
# Optional overrides:
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone

# OpenRouter transport. Setting OPENROUTER_API_KEY (and no TYPESAFE_API_KEY)
# selects it automatically; JEV_PROVIDER=openrouter forces it.
# OPENROUTER_API_KEY=
# JEV_PROVIDER=openrouter
# JEV_MODEL=typesafe/jev-1.13
# Optional OpenRouter app attribution:
# OPENROUTER_APP_NAME=save-token-jev
# OPENROUTER_APP_URL=https://github.com/IAmUnbounded/save-token-jev-clean
